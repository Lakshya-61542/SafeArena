# Copy to .env  (Windows: copy .env.example .env). .env is git-ignored and docker-ignored.
# Do not put quotes or trailing comments on the same line as a value.

# --- Client LLM ---------------------------------------------------------------
# mock   = works offline, deterministic (default)
# gemini = server-side calls to the Gemini API (needs GEMINI_API_KEY)
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15

# --- Local server ---------------------------------------------------------------
# Keep 127.0.0.1. Non-loopback values are refused unless SAFEARENA_ALLOW_REMOTE_BIND=1
# (the API has no authentication, so do not expose it).
BIND_HOST=127.0.0.1
BIND_PORT=8000

# --- Optional tuning ------------------------------------------------------------
MAX_PAYLOAD_CHARS=4000
RATE_LIMIT_PER_MINUTE=120
# SAFEARENA_ALLOWED_HOSTS=my-extra-hostname
